# Your Sento workspace's MCP address (from the console's install guide)
# and the courier connection key you minted there. The connection needs
# read and write granted on both metric entities named in feeds.json.
SENTO_MCP_URL=https://app.yourcompany-sento.com/api/mcp
SENTO_COURIER_KEY=...

# Windsor.ai API key (from your windsor.ai account page). Connect your
# Google Analytics and Search Console to Windsor once; this courier reads
# through it.
WINDSOR_API_KEY=...

# How often the loop wakes, in minutes. Daily feeds still write only once
# per day, after 07:00 UTC.
POLL_MINUTES=60

# Practice mode: logs what WOULD be written, writes nothing. Read one
# cycle's log, then set to false.
DRY_RUN=true
